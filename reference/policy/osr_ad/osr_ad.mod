// osr(analytic_derivation) / huge_number on Gali (2015, ch. 5) with an OSR Taylor rule.
// Macro switches (one .mod per case is generated by dump_osr_ad.m / the tests):
//   CONST:  a constant in the Taylor rule, so the steady state is non-zero and depends on
//           the osr_params (the analytic loss of +osr/objective.m adds E_y*E_y')
//   OSR_OPTIONS: the options of the osr command
//   ORDER2: a stoch_simul(order=2) before osr. Dynare 7.2's preprocessor does not compute the
//           second derivatives that analytic_derivation needs for osr (get_perturbation_params_derivs
//           then fails with "Undefined function '<fname>.dynamic_g2'"); an order-2 command anywhere
//           in the file makes it generate them
var pi y_gap i r_nat a u;
varexo eps_a eps_u;
parameters beta sigma varphi alpha epsilon theta rho_a rho_u kappa psi lambda phi_pi phi_y c;

beta = 0.99;
sigma = 1;
varphi = 5;
alpha = 0.25;
epsilon = 9;
theta = 0.75;
rho_a = 0.9;
rho_u = 0.5;
kappa = (1-theta)*(1-beta*theta)/theta*(1-alpha)/(1-alpha+alpha*epsilon)*(sigma+(varphi+alpha)/(1-alpha));
psi = (1+varphi)/(sigma*(1-alpha)+varphi+alpha);
lambda = kappa/epsilon;
phi_pi = 1.5;
phi_y = 0.125;
@#ifdef CONST
c = 0.01;
@#else
c = 0;
@#endif

model;
pi = beta*pi(+1) + kappa*y_gap + u;
y_gap = y_gap(+1) - 1/sigma*(i - pi(+1) - r_nat);
r_nat = -sigma*psi*(1-rho_a)*a;
i = phi_pi*pi + phi_y*y_gap + c;
a = rho_a*a(-1) + eps_a;
u = rho_u*u(-1) + eps_u;
end;

steady_state_model;
a = 0;
u = 0;
r_nat = 0;
pi = c/(1 - phi_pi - phi_y*(1-beta)/kappa);
y_gap = (1-beta)/kappa*pi;
i = pi;
end;

shocks;
var eps_a; stderr 0.01;
var eps_u; stderr 0.005;
end;

optim_weights;
pi 1;
y_gap lambda;
i 0.05;
pi, y_gap 0.01;
end;

osr_params phi_pi phi_y;
@#ifdef ORDER2
stoch_simul(order=2, irf=0, noprint, nomoments, nocorr, nofunctions);
@#endif
osr(order=1, irf=0, @{OSR_OPTIONS}) pi y_gap i;
